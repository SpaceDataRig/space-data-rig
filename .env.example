# Space Data Rig :: example environment. Copy to .env and fill in your own values.
# .env is read at boot by the Solana anchoring path and is NEVER committed or uploaded.

# Private (first-choice) Solana mainnet RPC. Put your provider URL + key here.  
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY   

# Comma-separated public fallback RPCs, tried when the private endpoint fails.
SOLANA_RPC_FALLBACKS=https://api.mainnet-beta.solana.com

# Path to a funded mainnet fee-payer keypair (JSON byte array). Optional; defaults
# to out/anchor-keypair.json (auto-generated, must hold real SOL to pay tx fees).
# SOLANA_KEYPAIR=out/anchor-keypair.json
