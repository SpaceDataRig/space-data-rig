# Space Data Rig :: example environment. Copy to .env and fill in your own values.
# .env is read at boot by the Solana anchoring path and is NEVER committed or uploaded.

# Private (first-choice) Solana mainnet RPC. Put your provider URL + key here.  
SOLANA_RPC=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY   

# Comma-separated public fallback RPCs, tried when the private endpoint fails.
SOLANA_RPC_FALLBACKS=https://api.mainnet-beta.solana.com

# Path to a funded mainnet fee-payer keypair (JSON byte array). Optional; defaults
# to out/anchor-keypair.json (auto-generated, must hold real SOL to pay tx fees).
# SOLANA_KEYPAIR=out/anchor-keypair.json

# ---- Optional live-model discussion (multi-provider) ----
# The war-room speaks from the computed numbers by default (grounded). Set a key below
# to let real models add critic caveats. Any OpenAI-compatible endpoint works. Keys are
# read only from the environment -- never logged, bundled, or anchored.

# Primary provider (DeepSeek by default).
# DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Second provider (xAI Grok, OpenAI-compatible) -- runs ALONGSIDE the primary so the
# discussion carries a caveat from each model, every one labeled with its model id.
# GROK_API_KEY=xai-YOUR_XAI_KEY
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-4.7
